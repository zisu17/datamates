.venv/
target/
dbt_packages/
logs/

# 로컬 Spark(session) 실행 부산물
.spark-warehouse/
metastore_db/
derby.log
spark-warehouse/

# 로컬 Iceberg REST 카탈로그의 sqlite 메타데이터
.iceberg-rest/

# Spark 이벤트 로그 (History Server 용)
.spark-events/

# edr 리포트 산출물
edr_target/

# 런타임 상태 — 메타스토어(SQLite)와 dbt 실행 산출물. 로컬 상태라 공유하면 서로 덮어쓴다
.datamates/

# 생성물. API 서버가 기동할 때 메타스토어를 보고 다시 만든다 (손으로 만든 dbt_smoke.py 는 남는다)
dags/datamates_*.py

# IDE
.idea/

# 파이썬 바이트코드
__pycache__/
*.pyc

.user.yml
.DS_Store

# 데모 녹화 도구와 산출물은 로컬에만 둔다.
# 도구 쪽은 소스가 9개뿐이지만 node_modules 에 ffmpeg 43MB 와 Playwright 가 딸려
# 오고(합쳐 71MB), 녹화 결과는 언제든 다시 만들 수 있다. 공개용 데모 파일은
# docs/images/ 에만 두고, 원본 mp4·gif 는 docs/assets/ 에 로컬로 남긴다.
docs/assets/
docs/BRANCHING.md

# scripts/ 는 로컬 도구다. 이관·점검처럼 한 번 쓰고 마는 개인 용도가 대부분이라
# 저장소에 남기지 않는다 (scripts/demo 도 여기 포함된다).
#
# 예외는 bootstrap_catalog.sh 하나다. README 설치 절차의 4번과 SETUP·compose 주석이
# 이걸 부르므로, 저장소를 새로 받은 사람 손에 반드시 있어야 한다.
scripts/*
!scripts/bootstrap_catalog.sh

# 손으로 만든 백업 묶음
*.tgz

# 로컬 전용 설정 (권한 허용 목록 등) — 사람마다 다르다
.claude/settings.local.json
